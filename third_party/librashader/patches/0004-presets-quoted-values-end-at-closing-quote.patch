+/// A value that opens with a closed quoted string is that string, as in
+/// RetroArch's config parser: `//` and `#` inside the quotes are not comments
+/// (`shader0 = "../..//edge-smoothing/..."`), and anything after the closing
+/// quote is ignored (`float_framebuffer0 = "true""`).
+fn quoted_value(input: Span) -> IResult<Span, Span> {
+    delimited(char('"'), is_not("\""), char('"')).parse(input)
+}
+
 fn parse_key_value(input: Span) -> IResult<Span, Token> {
     let (input, (key, _)) = take_up_to(parse_assignment).parse(input)?;
+    let (rest, line) = not_line_ending::<_, nom::error::Error<Span>>(input)?;
+    if let Ok((_, value)) = quoted_value(line) {
+        return Ok((rest, Token { key, value }));
+    }
     let (input, (_, value)) = map_res(not_line_ending, optional_quotes).parse(input)?;
     let (_, value) =
         take_until::<_, _, nom::error::Error<Span>>("//")(value).unwrap_or((input, value));
